#!/usr/bin/env python3

import os
import glob
import shutil

def distro():
	try:
		with open("/etc/os-release") as f:
			for line in f:
				if line.startswith("PRETTY_NAME="):
					return line.split("=", 1)[1].strip().strip('"')
	except:
		pass
	return "unknown"

def init():
	try:
#		return os.path.basename(os.readlink("/proc/1/exe"))
		with open("/proc/1/comm") as f:
			return f.read().strip()
	except:
		pass
	try:
		return os.path.basename(os.readlink("/proc/1/exe"))
	except:
		return "unknown"

def boot():
	if os.path.exists("/boot/grub") or os.path.exists("/etc/default/grub"):
		return "grub"
	if glob.glob("/boot/loader/entries/*.conf"):
		return "systemd-boot"
	return "unknown"

def main():
	d = distro()
	i = init()
	b = boot()
	kernel = os.uname().release
	root = os.geteuid() == 0
	systemd_ok = shutil.which("systemctl") and i == "systemd"

	print("=== System Environment ===")
	print("")
	print(f"  {'distro':<9} {d}")
	print(f"  {'init':<9} {i}")
	print(f"  {'boot':<9} {b}")
	print(f"  {'kernel':<9} {kernel}")
	print(f"  {'root':<9} {'yes' if root else 'no'}")
	print(f"  {'systemd':<9} {'yes' if systemd_ok else 'no'}")

if __name__ == "__main__":
	main()
	
